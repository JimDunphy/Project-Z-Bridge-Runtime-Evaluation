# Operator note: `.env.example` is the source of truth for supported tunables and defaults.
# For grouped explanations and tuning guidance, start with `docs/sysadmin/SYSADMIN_ENV_REFERENCE.md`.

# Host port for the shim (binds to 127.0.0.1)
BRIDGE_PORT=7777

# Optional: bind address inside the container / when running the shim directly.
# In docker-compose dev, this should stay `0.0.0.0:7777` so the port mapping works.
#BRIDGE_BIND=0.0.0.0:7777

# Optional: public HTTPS base URL when the bridge sits behind a reverse proxy.
# Used for absolute proxy URLs and as an HTTPS signal for cookie behavior.
# Example: https://mail.example.com
#BRIDGE_PUBLIC_BASE_URL=

# Optional: override the extracted Zimbra webclient root (inside the container).
# Default is `../static/zimbra` (relative to `/workspace/shim`).
#WEBCLIENT_ROOT=../static/zimbra

# Optional: cache-buster version string used by the web UI for assets.
# Default is a random UUID per shim start.
#BRIDGE_ASSET_VERSION=dev

# Optional: default ZWC theme/skin (aka "Theme" in Preferences → General).
# Examples: serenity, carbon, harmony.
#BRIDGE_DEFAULT_SKIN=serenity

# Optional: default timezone used by the Zimbra web client (IANA TZ database name).
# If unset, the shim falls back to the default calendar timezone (if available) or UTC.
BRIDGE_TIMEZONE=America/Los_Angeles

# Optional: delay (ms) before showing the left-pane mini calendar (ZWC default is 5000).
BRIDGE_MINICAL_DELAY_MS=0

# Optional: delay (ms) before showing the global busy cursor/overlay.
# Helps hide "flash busy" for short foreground requests while preserving busy for slower actions.
# - Default: 700
# - Set to 0 to disable delay and use stock behavior.
#BRIDGE_BUSY_OVERLAY_DELAY_MS=700

# Optional: short-lived cache + prefetch tuning for faster message-open latency.
# These only affect UI responsiveness and are safe to tune without data-model changes.
# - BRIDGE_GETMSG_CACHE_SECS: keep full Email/get payloads in memory for this many seconds.
# - BRIDGE_GETMSG_CACHE_MAX_ENTRIES: cap in-memory cache entry count.
# - BRIDGE_GETMSG_PREFETCH_COUNT: after SearchRequest, asynchronously prefetch this many visible rows.
# - BRIDGE_GETMSG_PREFETCH_MAX_BODY_BYTES: body cap used by prefetch Email/get calls.
# - BRIDGE_CONV_ABOVE_FOLD_BODY_PREFETCH_ENABLED: prefetch bodies for visible conversation rows
#   when a conversation page is built from upstream (not cache-hit returns).
# - BRIDGE_CONV_SCROLL_METADATA_PREFETCH_ENABLED: prefetch next conversation pages' metadata
#   (beneath current page) into conversation cache.
# - BRIDGE_CONV_INITIAL_METADATA_PREFETCH_IDLE_DELAY_MS: on first page open (offset=0), wait this
#   long before prefetching deeper pages, and only if the same folder/query is still active.
# - BRIDGE_CONV_SCROLL_METADATA_PREFETCH_PAGES: number of next pages to prewarm on scroll.
# - BRIDGE_CONV_SCROLL_METADATA_PREFETCH_MIN_INTERVAL_MS: cooldown per session/query/page key.
# - BRIDGE_SEARCH_PREFETCH_NEXT_WINDOW_ENABLED: when enabled, also prefetch the next page/window ids.
# - BRIDGE_SEARCH_PREFETCH_NEXT_WINDOW_LIMIT: max ids fetched for next-window warmup (ignored unless enabled).
# - BRIDGE_SEARCH_CONV_SEED_CACHE_SECS: keep single-message conversation seed entries for SearchConv.
# - BRIDGE_SEARCH_CONV_SEED_CACHE_MAX_ENTRIES: cap SearchConv seed cache entry count.
# - BRIDGE_THREAD_SUMMARY_CACHE_SECS: short-lived thread summary cache TTL.
# - BRIDGE_THREAD_SUMMARY_CACHE_MAX_ENTRIES: cap thread summary cache entry count.
# - BRIDGE_EMAIL_GET_CHUNK_SIZE: Email/get chunk size for participant summary expansion.
#BRIDGE_GETMSG_CACHE_SECS=45
#BRIDGE_GETMSG_CACHE_MAX_ENTRIES=512
#BRIDGE_GETMSG_PREFETCH_COUNT=24
#BRIDGE_GETMSG_PREFETCH_MAX_BODY_BYTES=5242880
#BRIDGE_CONV_ABOVE_FOLD_BODY_PREFETCH_ENABLED=1
#BRIDGE_CONV_SCROLL_METADATA_PREFETCH_ENABLED=1
#BRIDGE_CONV_INITIAL_METADATA_PREFETCH_IDLE_DELAY_MS=1500
#BRIDGE_CONV_SCROLL_METADATA_PREFETCH_PAGES=3
#BRIDGE_CONV_SCROLL_METADATA_PREFETCH_MIN_INTERVAL_MS=5000
#BRIDGE_SEARCH_PREFETCH_NEXT_WINDOW_ENABLED=0
#BRIDGE_SEARCH_PREFETCH_NEXT_WINDOW_LIMIT=24
#BRIDGE_SEARCH_CONV_SEED_CACHE_SECS=30
#BRIDGE_SEARCH_CONV_SEED_CACHE_MAX_ENTRIES=1024
#BRIDGE_THREAD_SUMMARY_CACHE_SECS=30
#BRIDGE_THREAD_SUMMARY_CACHE_MAX_ENTRIES=4096
#BRIDGE_EMAIL_GET_CHUNK_SIZE=200

# Optional: attachment-sort deep-scan tuning for very large mailboxes.
# See docs/sysadmin/SYSADMIN_ATTACHMENT_SORT_TRIAGE.md before changing these.
# - BRIDGE_ATTACHMENT_SORT_SCAN_THREADS: max candidate threads scanned for paperclip sorts.
# - BRIDGE_THREAD_GET_CHUNK_SIZE: Thread/get chunk size, clamped 1..500.
#BRIDGE_ATTACHMENT_SORT_SCAN_THREADS=1500
#BRIDGE_THREAD_GET_CHUNK_SIZE=200

# Optional: mail polling interval value used by ZWC (`zimbraPrefMailPollingInterval`).
# - Default: 500 (enables ZWC instant-notify mode when `zimbraFeatureInstantNotify` is true).
# - If you set a non-500 value, ZWC will use traditional polling (seconds).
BRIDGE_MAIL_POLL_INTERVAL=500

# Optional: server-side block time for ZWC's instant-notify polling (`NoOpRequest wait=1`).
# Default: 30 seconds.
#BRIDGE_NOOP_WAIT_SECS=30

# Optional: let NoOp use JMAP Mailbox/changes to skip quiet mailbox refreshes.
# Default: 1 (enabled). Unsafe or unsupported cases fall back to the full refresh path.
#BRIDGE_NOOP_MAILBOX_CHANGES_ENABLED=1

# Optional: JMAP incremental rollout mode.
# - `off` (default): no incremental eligibility telemetry.
# - `observe`: log Email/query `queryState` / `canCalculateChanges` telemetry on hot paths.
# - `on`: reserved for future incremental execution paths; currently same telemetry behavior as `observe`.
#BRIDGE_JMAP_INCREMENTAL_MODE=off

# Optional: JMAP push-driven hot-folder prewarm.
# - Enables a per-session EventSource listener (if upstream advertises `eventSourceUrl`).
# - On mail/mailbox state changes, the shim prewarms a small set of hot folder queries.
# - Existing NoOp polling remains as fallback.
#BRIDGE_PUSH_WARM_ENABLED=1
#BRIDGE_PUSH_HOT_MAX_QUERIES=4
#BRIDGE_PUSH_PREWARM_LIMIT=100
#BRIDGE_PUSH_PREWARM_MIN_INTERVAL_MS=5000
# Optional: keep hot folders warm periodically even without push events.
#BRIDGE_PUSH_NOOP_PREWARM_ENABLED=1
#BRIDGE_PUSH_NOOP_PREWARM_INTERVAL_MS=300000
# Optional values: `no` (keep open) or `state` (close after one state event).
#BRIDGE_PUSH_CLOSEAFTER=no
#BRIDGE_PUSH_PING_SECS=30
# Optional: override event data types requested from EventSource template.
#BRIDGE_PUSH_EVENT_TYPES=Mailbox,Email

# Optional: local AI automation extension control-plane (phase 3 dry-run).
# - Disabled by default.
# - Scope: provider preflight/status + per-user policy + provider-backed read-only planning.
# - `execute` remains intentionally blocked (dry-run only).
# - Providers are local CLI tools installed on the bridge host.
#BRIDGE_AI_ENABLED=0
#BRIDGE_AI_DEPLOYMENT_MODE=local_desktop
#BRIDGE_AI_PROVIDERS=codex,claude,gemini
#BRIDGE_AI_PROVIDER_PREFLIGHT_TIMEOUT_MS=4000
#BRIDGE_AI_PROVIDER_PLAN_TIMEOUT_MS=90000
#BRIDGE_AI_CODEX_MODEL=gpt-5.3-codex-spark
#BRIDGE_AI_PROVIDER_FAILOVER_ENABLED=0
#BRIDGE_AI_PLAN_ALLOW_HEURISTIC_FALLBACK=0
# Optional: host-side AI runner. This requires a separate host process so local
# provider CLI auth/API keys can be reused outside the runtime container.
# The bridge container reaches the host via host.docker.internal.
#BRIDGE_AI_RUNNER_URL=http://host.docker.internal:8765
#BRIDGE_AI_RUNNER_TOKEN=
#BRIDGE_AI_RUNNER_BIND=0.0.0.0
#BRIDGE_AI_RUNNER_PORT=8765
#BRIDGE_AI_RUNNER_CONTEXT_DIR=./data/ai-runner/context
#BRIDGE_AI_RUNNER_DEFAULT_TIMEOUT_MS=90000
#BRIDGE_AI_RUNNER_MAX_TIMEOUT_MS=600000
#BRIDGE_AI_RUNNER_ALLOW_PROVIDERS=codex,claude,gemini
#BRIDGE_AI_RUNNER_STRICT_SCHEMA=0
#BRIDGE_AI_RUNNER_ALLOW_LOCAL_FALLBACK=0

# Optional: phase-1 email body iframe sandbox rollout (canary-safe).
# - Enable globally with `BRIDGE_EMAIL_IFRAME_SANDBOX_ENABLED=true`.
# - Start with `allow-same-origin` for compatibility.
# - `BRIDGE_EMAIL_IFRAME_SANDBOX_USER_ALLOWLIST` supports:
#   - exact user (`ceo@example.com`)
#   - domain suffix (`@example.com`)
#   - wildcard (`*`)
# - Suggested staged hardening:
#   - CFO-only canary: `BRIDGE_EMAIL_IFRAME_SANDBOX_USER_ALLOWLIST=cfo@company.com`
#   - Executive cohort: `BRIDGE_EMAIL_IFRAME_SANDBOX_USER_ALLOWLIST=cfo@company.com,ceo@company.com`
#   - Entire org domain: `BRIDGE_EMAIL_IFRAME_SANDBOX_USER_ALLOWLIST=@company.com`
# - Empty allowlist means all authenticated users when enabled=true.
#BRIDGE_EMAIL_IFRAME_SANDBOX_ENABLED=false
#BRIDGE_EMAIL_IFRAME_SANDBOX_POLICY=allow-same-origin
#BRIDGE_EMAIL_IFRAME_SANDBOX_USER_ALLOWLIST=

# Optional: phase-2 email iframe renderer (tokenized register/view flow).
# - When enabled, client registers sanitized HTML then loads it from:
#   `/service/email-renderer/view/<token>`
# - `BRIDGE_EMAIL_IFRAME_RENDERER_ORIGIN` lets you point iframe src to a dedicated
#   host/origin (for example `https://mail-render.example.com`).
# - If allowlist is empty, all authenticated users are eligible when enabled=true.
# - Keep sandbox strict (no `allow-same-origin`) unless you have a known compatibility need.
#BRIDGE_EMAIL_IFRAME_RENDERER_ENABLED=false
#BRIDGE_EMAIL_IFRAME_RENDERER_USER_ALLOWLIST=
#BRIDGE_EMAIL_IFRAME_RENDERER_ORIGIN=
#BRIDGE_EMAIL_IFRAME_RENDERER_TTL_SECS=180
#BRIDGE_EMAIL_IFRAME_RENDERER_MAX_BYTES=1048576
#BRIDGE_EMAIL_IFRAME_RENDERER_MAX_ENTRIES=512
#BRIDGE_EMAIL_IFRAME_RENDERER_SANDBOX_POLICY=allow-popups allow-popups-to-escape-sandbox

# Optional: phase-1 dumpster ("Recover Deleted Items") integration.
# - Disabled by default.
# - Current scope includes listing via `SearchRequest inDumpster=1` and
#   restore via `MsgActionRequest`/`ItemActionRequest op=recover`.
# - Stalwart undelete restores messages to Inbox; ZWC-selected restore
#   destinations are not honored end-to-end yet.
# - `BRIDGE_DUMPSTER_API_BASE_URL` defaults to `STALWART_API_BASE_URL`, then `STALWART_BASE_URL`.
# - Auth defaults to the user's session token; optionally override with admin creds below.
#BRIDGE_DUMPSTER_ENABLED=0
#BRIDGE_DUMPSTER_API_BASE_URL=https://mail-internal.example.com
#BRIDGE_DUMPSTER_ADMIN_BEARER_TOKEN=
#BRIDGE_DUMPSTER_ADMIN_USERNAME=
#BRIDGE_DUMPSTER_ADMIN_PASSWORD=
#BRIDGE_DUMPSTER_PAGE_SIZE=100

# Optional: serve stale folder conversation cache immediately and revalidate in background.
# This improves perceived folder-click speed after idle periods.
#BRIDGE_SEARCH_CACHE_STALE_REVALIDATE=1
#BRIDGE_SEARCH_CACHE_STALE_REVALIDATE_MIN_INTERVAL_MS=2000

# Optional: let simple-folder stale revalidation use JMAP Email/queryChanges.
# The delta flag applies small safe changed deltas; unsafe cases still fall back.
#BRIDGE_EMAIL_QUERY_CHANGES_ENABLED=1
#BRIDGE_EMAIL_QUERY_CHANGES_DELTA_ENABLED=1

# Optional: RSS/Atom feed polling interval (seconds) while a user is logged in.
# The shim polls feed folders on `NoOpRequest`, rate-limited by this interval.
# - Default: 900 (15 minutes)
# - Set to 0 to disable background feed polling (manual "Sync" still works).
#BRIDGE_FEED_POLL_SECS=900

# Optional: folder retention sweep interval (seconds) while a user is logged in.
# The shim enforces folder purge retention policies by periodically deleting old messages.
# - Default: 86400 (daily)
# - Set to 0 to disable retention enforcement.
# - Sweeps only run while a user session is active (`NoOpRequest`).
# - If a save-triggered immediate sweep hits the destroy cap, the remaining backlog waits until the next sweep window.
#BRIDGE_RETENTION_SWEEP_SECS=86400
# Optional: retention destroy cap per sweep across all folders.
# - Default: 2000
# - Clamped to 1..100000.
# - Applies to both save-triggered immediate sweeps and later automatic sweeps.
#BRIDGE_RETENTION_MAX_DESTROY_PER_SWEEP=2000

# Optional: shim-side performance caches (seconds).
# These caches speed up ZWC login for large accounts by reusing previously generated data.
# They are best-effort and safe to lose on restart (live data will eventually refresh).
# - Set to 0 to disable a cache.
# - BRIDGE_APPOINTMENT_SEARCH_CACHE_SECS persists calendar appointment search responses.
#BRIDGE_CONVERSATION_CACHE_SECS=300
#BRIDGE_CONTACTS_CF_CACHE_SECS=3600
#BRIDGE_MAILBOX_CACHE_SECS=300
#BRIDGE_GETINFO_CACHE_SECS=86400
#BRIDGE_APPOINTMENT_SEARCH_CACHE_SECS=3600
#BRIDGE_FILTER_ADDRESS_BOOKS_CACHE_SECS=120
#BRIDGE_FILTER_MODIFY_SYNC_DEBOUNCE_MS=1500

# Optional: lower the upload limit advertised to ZWC and enforced by `/service/upload`.
# - Default: Stalwart JMAP core `maxSizeUpload`.
# - If set above Stalwart's advertised maximum, the bridge logs a warning and uses Stalwart's maximum.
#BRIDGE_UPLOAD_MAX_BYTES=50000000

# Optional: persistent data directory for local bridge state and caches.
# Runtime compose sets BRIDGE_DATA_DIR=/data and mounts ./data to /data.
# Do not change this unless you also change docker-compose.yml.
#BRIDGE_DATA_DIR=/data

# Optional: mark `ZM_AUTH_TOKEN` cookies as `Secure` (recommended behind HTTPS).
# - When running on plain `http://127.0.0.1`, leave this off.
# - When running behind an HTTPS reverse proxy (nginx), set to `1`.
# - Important: the shim does not infer this from `X-Forwarded-Proto`; either set this explicitly
#   or set `BRIDGE_PUBLIC_BASE_URL=https://...` so the bridge knows the public scheme is HTTPS.
#BRIDGE_COOKIE_SECURE=0

# Optional: secret used to sign `/service/image-proxy/...` URLs.
# - Required for stable image-proxy URLs across bridge restart.
# - Also acts as the anti-forgery signing key for `/service/image-proxy/...`; without a valid
#   signature, callers cannot fabricate arbitrary proxy fetch URLs.
# - If unset, the shim uses a random per-process secret and already-rendered messages may lose
#   image loads after restart until the message body is fetched and rewritten again.
#BRIDGE_IMAGE_PROXY_SECRET=change-me-to-a-long-random-string

# Optional: IDN / homograph defense for HTML mail links.
# When enabled, the shim normalizes internationalized domain names (IDN) to punycode (xn--...)
# in `<a href="...">` so the real destination is visible on hover/status bars.
# - Default: 1 (enabled)
# - Set to 0 to leave Unicode hostnames as-is (useful for international IDN-heavy environments).
#BRIDGE_SECURITY_IDN_PUNYCODE=1

# Optional: enable delivery-time filter activation by compiling ZWC rules to Sieve and activating
# via JMAP SieveScript.
# - Compose files default this to 0 unless `.env` sets it.
# - This example file sets it to 1 as an explicit opt-in sample for active
#   delivery-time filtering.
# - Set to 0 to store the rule model without changing the active delivery script.
BRIDGE_SIEVE_ACTIVATE=1

# Optional: the Sieve script name that zbridge manages for incoming filters (activated when enabled).
BRIDGE_SIEVE_INCOMING_SCRIPT_NAME=zbridge-incoming

# Optional: when `BRIDGE_SIEVE_ACTIVATE=0`, store the incoming rule model in this non-active script.
# Default: `<BRIDGE_SIEVE_INCOMING_SCRIPT_NAME>-model`.
BRIDGE_SIEVE_INCOMING_MODEL_SCRIPT_NAME=zbridge-incoming-model

# Optional: non-active script name used to store outgoing rule model (execution not implemented).
BRIDGE_SIEVE_OUTGOING_SCRIPT_NAME=zbridge-outgoing

# Optional: base script include order when preserving an existing active script (`first` or `last`).
# Default: `last` (zbridge rules run first, then base script).
BRIDGE_SIEVE_BASE_ORDER=last

# Optional: comma-separated `X-Spamd-Result` tokens that trigger the hidden managed
# "Foreign Country" tag when that preference is enabled.
# Default: `BLACKLIST_COUNTRY(`
# Recommended: include the opening `(` because the hidden Sieve rule does a simple
# `header :contains` match against the raw `X-Spamd-Result` text, and Rspamd commonly
# renders symbols as `SYMBOL(score)`. If your deployment emits a bare symbol with no
# score, override this with `BLACKLIST_COUNTRY`.
# Example override if your Rspamd deployment uses a different symbol:
#BRIDGE_MANAGED_FOREIGN_COUNTRY_SYMBOLS=BLACKLIST_COUNTRY(

# Optional: backups (created on every filter save when activation is enabled).
# - Upstream backups are created as additional non-active scripts with this prefix.
# - The shim keeps the newest `BRIDGE_SIEVE_BACKUP_KEEP` scripts.
# - `BRIDGE_SIEVE_BACKUP_MIN_INTERVAL_SECS` throttles backup frequency during repeated edits.
# - `BRIDGE_FILTER_MODIFY_SYNC_DEBOUNCE_MS` coalesces rapid filter edits before upstream sync.
#   Set to `0` to force synchronous upstream writes for every ModifyFilterRulesRequest.
BRIDGE_SIEVE_BACKUP_PREFIX=zbridge-backup
BRIDGE_SIEVE_BACKUP_KEEP=3
BRIDGE_SIEVE_BACKUP_MIN_INTERVAL_SECS=300
BRIDGE_FILTER_MODIFY_SYNC_DEBOUNCE_MS=1500

# Optional: guardrails for contact-based filter expansion when compiling Sieve.
# - `BRIDGE_FILTER_ADDRESS_SET_MAX`: max addresses allowed per Contacts/My Frequent Emails source.
#   Set to `0` to disable this limit.
# - `BRIDGE_FILTER_SIEVE_SCRIPT_MAX_BYTES`: max generated incoming Sieve script size in bytes.
#   Set to `0` to disable this limit.
BRIDGE_FILTER_ADDRESS_SET_MAX=5000
BRIDGE_FILTER_SIEVE_SCRIPT_MAX_BYTES=262144

# Optional: standard Rust log filter.
# Levels: error, warn, info, debug, trace
# Examples:
# - `RUST_LOG=info`
# - `RUST_LOG=zbridge_shim=debug` (`zbridge_shim=debug` is the value; it scopes debug logs to the bridge target)
# Note: define `RUST_LOG` only once in `.env` (the last assignment wins).
RUST_LOG=info

# Optional: Content Security Policy (CSP) for the legacy ZWC UI.
# Because ZWC uses inline scripts and eval-like packaging, a strict CSP will break the UI.
# - Default mode is `report-only`.
# - Set `BRIDGE_CSP_MODE=log` to collect browser violation reports at `BRIDGE_CSP_REPORT_URI` (default `/csp-report`).
# - Set `BRIDGE_CSP_MODE=enforce` once you’ve confirmed it doesn’t break your workflows.
#BRIDGE_CSP_MODE=report-only
#BRIDGE_CSP_REPORT_URI=/csp-report
#BRIDGE_CSP=default-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';

# Optional: branding for the Zimbra Classic UI chrome (top-left banner).
# - If unset, defaults to Stalwart branding.
# - `BRIDGE_BRAND_LOGO_URL` should be a URL the browser can fetch (e.g. `/zimbra/brand/logo.svg` or `https://...`).
# - `BRIDGE_BRAND_LOGO_PATH` is a filesystem path inside the container used by `/zimbra/brand/logo.svg`.
# - `BRIDGE_BRAND_FAVICON_URL` is optional and defaults to the shipped/static favicon behavior.
BRIDGE_BRAND_NAME=Stalwart
BRIDGE_BRAND_LINK_URL=https://stalw.art/
BRIDGE_BRAND_LOGO_URL=
BRIDGE_BRAND_LOGO_PATH=
BRIDGE_BRAND_FAVICON_URL=

# Optional: text shown in ZWC “Help → About”.
# - Defaults to “Project Z Bridge”.
# - The ZWC version/build is still shown (from the `zm-web-client` assets).
BRIDGE_ABOUT_PRODUCT_NAME=Project Z Bridge

# Optional developer/debug logging. Leave disabled unless investigating contacts
# canonical-form output.
#BRIDGE_DEBUG_CONTACTS_CF=0

# Upstream Stalwart JMAP (no secrets committed; put real values in .env)
#
# Notes:
# - The ZWC login screen uses whatever username/password you type and authenticates to Stalwart via JMAP.
STALWART_BASE_URL=https://mail.example.com
# Optional: override the Stalwart management API base URL used by `/zimbra/h/changepass`.
# - Defaults to `STALWART_BASE_URL`
# - In production, set this to an internal/loopback URL if you do not expose `/api` publicly.
#STALWART_API_BASE_URL=https://mail-internal.example.com
STALWART_USERNAME=user@example.com
STALWART_PASSWORD=change-me
